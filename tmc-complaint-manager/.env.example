# Copy to .env and replace every placeholder with private values.
DB_USERNAME=replace-with-a-dedicated-database-user
DB_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=
APP_STAFF_NAME=
APP_STAFF_EMAIL=
APP_STAFF_DEPARTMENT=
APP_STAFF_PASSWORD=
HTTP_PORT=80
SESSION_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173
DUPLICATE_LOOKBACK_DAYS=30
DUPLICATE_MINIMUM_SCORE=0.40
DUPLICATE_LOCATION_RADIUS_METERS=1000
# No classifier provider is configured; keep disabled until one is reviewed and implemented.
CLASSIFICATION_ENABLED=false
CLASSIFICATION_MINIMUM_CONFIDENCE=0.75
NOTIFICATIONS_ENABLED=false
# Leave these at 0 until TMC approves official service targets.
SLA_RESPONSE_HOURS=0
SLA_RESOLUTION_HOURS=0
